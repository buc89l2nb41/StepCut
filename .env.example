# OBS websocket (OBS > Tools > WebSocket Server Settings > Show Connect Info)
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=

# Cursor agent (python -m stepcut agent). Or run `cursor-agent login` instead.
CURSOR_API_KEY=
